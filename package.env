# ==============================================================================
# Package Configuration for tmux .deb Builder
# ==============================================================================
# Edit this file to customize Debian package metadata.
# These values can also be overridden by setting environment variables
# or passing command-line arguments to scripts/build-deb.sh.
# ==============================================================================

# Package name in Debian/Ubuntu package manager
PACKAGE_NAME="${PACKAGE_NAME:-tmux}"

# Debian package revision (e.g. 1 in tmux_3.8-1_amd64.deb)
PACKAGE_REVISION="${PACKAGE_REVISION:-1}"

# Maintainer of the package (Full Name <email@address>)
MAINTAINER="${MAINTAINER:-Brozi <barchanowiczjan@gmail.com>}"

# Package section in Debian repositories (usually "admin" or "utils")
SECTION="${SECTION:-admin}"

# Package priority ("optional", "standard", "extra")
PRIORITY="${PRIORITY:-optional}"

# Upstream project homepage
HOMEPAGE="${HOMEPAGE:-https://tmux.github.io/}"

# Packages provided/replaced/conflicted (for drop-in compatibility)
PROVIDES="${PROVIDES:-tmux}"
REPLACES="${REPLACES:-tmux}"
CONFLICTS="${CONFLICTS:-}"

# Debian short description (synopsis, one line)
DESCRIPTION_SUMMARY="${DESCRIPTION_SUMMARY:-terminal multiplexer}"

# Debian extended description (lines indented with a leading space; '.' for blank lines)
DESCRIPTION_BODY="${DESCRIPTION_BODY:- tmux enables a number of terminals (or windows) to be accessed and
 controlled from a single terminal like screen. tmux runs as a
 server-client system. A server is created automatically when necessary
 and holds a number of sessions, each of which may have a number of
 windows linked to it. Any number of clients may connect to a session,
 or the server may be controlled by issuing commands with tmux.
 Communication takes place through a socket, by default placed in /tmp.
 Moreover tmux provides a consistent and well-documented command
 interface, with the same syntax whether used interactively, as a key
 binding, or from the shell. It offers a choice of vim or Emacs key
 layouts.
 .
 This package provides a self-contained, statically-linked build of tmux
 compiled from tmux/tmux-builds with musl-libc, libevent, and ncurses,
 featuring zero external runtime shared-library dependencies.
 Compatible with Debian 11 (Bullseye), Debian 12 (Bookworm), Debian 13 (Trixie),
 Debian 14 (Forky), Debian Sid, and Ubuntu Jammy (22.04), Noble (24.04),
 Questing (25.10), Resolute (26.04).}"
